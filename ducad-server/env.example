# ==============================================================================
# ducad-server — contoh konfigurasi
#
# Salin menjadi `.env` lalu isi dengan nilai sungguhan. `.env` sudah masuk
# `.gitignore`.
#
# Kredensial di bawah HARUS milik DUCAD sendiri. Memakai ulang kredensial
# aplikasi lain membuat layar consent Google/GitHub menyebut nama aplikasi
# tersebut kepada pengguna DUCAD — persis masalah yang membuat server ini
# dipisahkan (lihat README.md §1).
# ==============================================================================

# ─── Dasar ────────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://ducad:sandi@127.0.0.1:3306/ducad_server
SERVER_PORT=8430
# URL publik server. Dipakai menurunkan redirect URI ketiga provider bila
# variabel *_REDIRECT_URI di bawah tidak diisi.
SERVER_BASE_URL=https://api.ducad.app

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Minimal 32 byte acak. Membuat: openssl rand -hex 32
JWT_SECRET=ganti-dengan-32-byte-acak
JWT_ACCESS_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=30

# ─── Google — OAuth Client bernama "DUCAD" ────────────────────────────────────
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Opsional; default {SERVER_BASE_URL}/api/v1/auth/callback/google
GOOGLE_REDIRECT_URI=

# ─── GitHub — OAuth App bernama "DUCAD" ───────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# ─── Sign in with Apple ───────────────────────────────────────────────────────
# Diwajibkan App Store Guideline 4.8 untuk build iPad.
#
# APPLE_CLIENT_ID WAJIB berupa *Services ID*, BUKAN bundle ID aplikasi.
# Salah satu ini adalah kesalahan konfigurasi paling sering, dan gejalanya
# menyesatkan: Safari menampilkan "Sign Up Not Complete".
#
# Tidak ada client secret statis — server mencetak JWT ES256 berumur pendek
# dari kunci `.p8` di bawah.
APPLE_CLIENT_ID=id.ducad.studio.signin
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=YYYYYYYYYY
# Disarankan: mount berkas `.p8` sebagai rahasia.
APPLE_PRIVATE_KEY_PATH=/run/secrets/AuthKey.p8
# Alternatif untuk platform yang hanya punya env secret satu baris — isi PEM
# dengan "\n" literal sebagai pemisah baris:
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----
#
# Return URL WAJIB https dan harus terdaftar di Services ID. Apple menolak
# http, termasuk localhost — Sign in with Apple tidak bisa diuji di server
# lokal biasa.
APPLE_REDIRECT_URI=

# ─── Lain-lain ────────────────────────────────────────────────────────────────
# Origin yang diizinkan CORS, dipisah koma. Aplikasi desktop/iPad tidak
# terpengaruh (bukan browser); ini untuk landing page.
ALLOWED_ORIGINS=https://ducad.app,https://www.ducad.app

# Tier lisensi untuk akun baru. Ditampilkan aplikasi sebagai
# "Ducad {nilai} Tier", jadi tulis dengan kapitalisasi yang pantas dilihat.
DEFAULT_LICENSE_TIER=Pro

# Tingkat log: ducad_server=debug untuk melihat detail alur login.
RUST_LOG=ducad_server=info,tower_http=info
