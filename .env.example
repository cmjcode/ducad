# Salin berkas ini ke `.env` (jangan pernah commit `.env` ke git) untuk
# penandatanganan kode & notarisasi macOS / iPadOS lokal.

APPLE_ID='developer@example.com'
APPLE_TEAM_ID='YOUR_TEAM_ID'
APPLE_BUNDLE_ID='id.ducad.studio'
# Gunakan App-Specific Password dari https://appleid.apple.com (bukan kata sandi utama)
APPLE_PASSWORD=''
APPLE_IDENTITY='Developer ID Application: Nama Perusahaan (YOUR_TEAM_ID)'
APPLE_IDENTITY_INS='Developer ID Installer: Nama Perusahaan (YOUR_TEAM_ID)'
# Opsional untuk paket Mac App Store:
# APPLE_APP_IDENTITY='3rd Party Mac Developer Application: Nama Perusahaan (YOUR_TEAM_ID)'
# NOTARIZE=1

