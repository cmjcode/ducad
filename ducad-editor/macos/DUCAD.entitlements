<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Enable App Sandbox (required for Mac App Store) -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Allow outgoing network connections (cloud sync / updates) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Allow the user to open/save CAD files they choose (STEP, IGES, STL, DUCAD projects) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Allow reading documents selected by user -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
</dict>
</plist>
