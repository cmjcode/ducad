# Maintainer: Yulius Jayuda <yulius.jayuda@gmail.com>
#
# Source package: builds DUCAD from the tagged release on GitHub.
# `pkgver`, `pkgrel`, and the local-file checksums are maintained by
# `scripts/update-aur.sh`; edit everything else here by hand.
#
# The OpenCASCADE bindings live in a git SUBMODULE (ducad-editor/vendors/
# opencascade-rs), so the GitHub tarball is NOT buildable. The submodule is
# fetched as a second git source and wired in during prepare().

pkgname=ducad
pkgver=0.4.0
pkgrel=1
pkgdesc="Parametric 2D/3D CAD: constraint-based sketching and B-rep solid modeling on OpenCASCADE, with a headless CLI and MCP server"
arch=('x86_64' 'aarch64')
url="https://github.com/cmjcode/ducad"
license=('AGPL-3.0-only')
# OCCT is linked dynamically from the system package (>= 7.8 required by
# opencascade-sys). winit/wgpu need xkbcommon + xcb/x11 + wayland + Vulkan.
depends=(
  gcc-libs
  glibc
  opencascade
  libxkbcommon
  libxkbcommon-x11
  libxcb
  libx11
  libxcursor
  libxi
  libxrandr
  wayland
  vulkan-icd-loader
  hicolor-icon-theme
)
makedepends=(cargo cmake git)
optdepends=(
  'xdg-desktop-portal: native file open/save dialogs'
  'vulkan-driver: GPU rendering backend (e.g. vulkan-radeon, vulkan-intel, nvidia-utils)'
)
source=(
  "$pkgname::git+$url.git#tag=v$pkgver"
  "opencascade-rs::git+https://github.com/cmjcode/opencascade-rs.git"
  "ducad.desktop"
)
sha256sums=('SKIP'
            'SKIP'
            '00583e812954846985aba944e89e0f98b4ab999b12661df6993724e86ffd4a39')

prepare() {
  cd "$srcdir/$pkgname"
  # Point the submodule at the locally cloned mirror instead of the network.
  git submodule init
  git config submodule.ducad-editor/vendors/opencascade-rs.url "$srcdir/opencascade-rs"
  git -c protocol.file.allow=always submodule update

  cd ducad-editor
  export CARGO_HOME="$srcdir/cargo"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/$pkgname/ducad-editor"
  export CARGO_HOME="$srcdir/cargo"
  export CARGO_TARGET_DIR="$srcdir/target"
  export RUSTUP_TOOLCHAIN=stable
  # GUI, headless CLI, and the MCP server share one workspace build.
  cargo build --release --frozen -p ducad-app -p ducad-cli -p ducad-mcp
}

check() {
  cd "$srcdir/$pkgname/ducad-editor"
  export CARGO_HOME="$srcdir/cargo"
  export CARGO_TARGET_DIR="$srcdir/target"
  export RUSTUP_TOOLCHAIN=stable
  # Only the kernel-free crates: the OCCT-backed suites take very long and
  # the GUI suites need a display.
  cargo test --release --frozen -p ducad-core -p ducad-sketch
}

package() {
  cd "$srcdir/$pkgname"
  install -Dm755 "$srcdir/target/release/ducad" "$pkgdir/usr/bin/ducad"
  install -Dm755 "$srcdir/target/release/ducad-cli" "$pkgdir/usr/bin/ducad-cli"
  install -Dm755 "$srcdir/target/release/ducad-mcp" "$pkgdir/usr/bin/ducad-mcp"

  install -Dm644 "$srcdir/ducad.desktop" "$pkgdir/usr/share/applications/ducad.desktop"
  install -Dm644 ducad-editor/images/logo.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/ducad.svg"
  install -Dm644 ducad-editor/images/logo.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/ducad.png"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
